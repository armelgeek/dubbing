# Core Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/dubbing?search_path=public

# Auth / Frontend
BETTER_AUTH_SECRET=replace_with_secure_random
BETTER_AUTH_URL=http://localhost:3000
REACT_APP_URL=http://localhost:5173

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_LIPSYNC=false

# Providers / Storage
STORAGE_PROVIDER=local # local | minio
# Local assets storage mapping
ASSETS_BASE_DIR=/tmp/dubbing-assets
ASSETS_PUBLIC_PREFIX=/assets

# FFmpeg
# Absolute path to ffmpeg binary (optional if ffmpeg is in PATH)
#FFMPEG_BIN=/usr/bin/ffmpeg
# If ffmpeg is unavailable and you want the pipeline not to fail, enable placeholder (1 to enable)
MUX_FALLBACK_PLACEHOLDER=0

# MinIO (used if STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dubbing-assets
MINIO_PUBLIC_BASE=http://localhost:9000

# Email (SMTP)
SMTP_HOST=0.0.0.0
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# Optional: Additional tuning
# LOG_LEVEL=info
# TTS_PROVIDER=local
# TRANSCRIPTION_PROVIDER=local
# TRANSLATION_PROVIDER=local